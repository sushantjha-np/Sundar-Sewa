<script>
(function(){
  'use strict';

  /* ===== INTRO ===== */
  var proIntro = document.getElementById('proIntro');
  function hideIntro(){
    if(!proIntro) return;
    proIntro.classList.add('hidden');
    document.body.classList.remove('intro-active');
    document.body.classList.add('intro-done');
    setTimeout(function(){ if(proIntro.parentNode) proIntro.parentNode.removeChild(proIntro); }, 500);
  }
  setTimeout(hideIntro, 2100);

  /* ===== BUILD DASHBOARD BARS ===== */
  var bars = document.getElementById('dashBars');
  if(bars){
    var heights = [45,70,55,90,40,80,65,100,50,75];
    heights.forEach(function(h,i){
      var b = document.createElement('div');
      b.className = 'dash-bar';
      b.style.height = h + '%';
      b.style.animationDelay = (i*0.08) + 's';
      bars.appendChild(b);
    });
  }

  /* ===== COUNT-UP ANIMATION ===== */
  function countUp(el){
    var target = parseInt(el.getAttribute('data-count'),10);
    if(isNaN(target)) return;
    var current = 0;
    var step = Math.max(1, Math.ceil(target / 40));
    var suffix = el.textContent.replace(/[0-9]/g,'');
    var tick = function(){
      current += step;
      if(current >= target){ el.textContent = target + (target >= 100 ? '+' : '+'); return; }
      el.textContent = current;
      requestAnimationFrame(tick);
    };
    tick();
  }

  /* ===== SCROLL REVEAL ===== */
  var revealEls = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
  var counters = document.querySelectorAll('[data-count]');
  var counterObserved = new WeakSet();

  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
    revealEls.forEach(function(el){ io.observe(el); });

    var counterIo = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting && !counterObserved.has(e.target)){
          counterObserved.add(e.target);
          countUp(e.target);
          counterIo.unobserve(e.target);
        }
      });
    }, {threshold:.5});
    counters.forEach(function(el){ counterIo.observe(el); });
  } else {
    revealEls.forEach(function(el){ el.classList.add('visible'); });
    counters.forEach(countUp);
  }

  /* ===== HEADER + BACK TO TOP ===== */
  var header = document.getElementById('siteHeader');
  var toTop = document.getElementById('toTop');
  function onScroll(){
    header.classList.toggle('scrolled', window.scrollY > 10);
    toTop.classList.toggle('show', window.scrollY > 600);
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
  toTop.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });

  /* ===== MOBILE MENU ===== */
  var menuToggle = document.getElementById('menuToggle');
  var navMenu = document.getElementById('navMenu');
  var backdrop = document.getElementById('navBackdrop');
  var menuIcon = menuToggle.querySelector('i');
  function setMenu(open){
    navMenu.classList.toggle('open', open);
    backdrop.classList.toggle('show', open);
    menuIcon.className = open ? 'fas fa-times' : 'fas fa-bars';
    menuToggle.setAttribute('aria-expanded', open);
    document.body.style.overflow = open ? 'hidden' : '';
  }
  menuToggle.addEventListener('click', function(e){ e.stopPropagation(); setMenu(!navMenu.classList.contains('open')); });
  backdrop.addEventListener('click', function(){ setMenu(false); });
  navMenu.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', function(){ setMenu(false); }); });
  window.addEventListener('resize', function(){ if(window.innerWidth > 992) setMenu(false); });

  /* ===== DRAGGABLE FLOATING CONTACT ===== */
  var fc = document.getElementById('floatingContact');
  var handle = fc.querySelector('.drag-handle');
  var dragging = false, offX = 0, offY = 0;
  try{
    var saved = JSON.parse(localStorage.getItem('floatingContactPosition') || 'null');
    if(saved){ fc.style.left = saved.left; fc.style.bottom = saved.bottom; }
  }catch(e){}
  function start(e){
    dragging = true;
    var r = fc.getBoundingClientRect();
    var p = e.touches ? e.touches[0] : e;
    offX = p.clientX - r.left; offY = p.clientY - r.top;
    e.preventDefault();
  }
  function move(e){
    if(!dragging) return;
    var p = e.touches ? e.touches[0] : e;
    var nl = p.clientX - offX;
    var nb = window.innerHeight - (p.clientY - offY) - fc.offsetHeight;
    fc.style.left = Math.max(0, Math.min(nl, window.innerWidth - fc.offsetWidth)) + 'px';
    fc.style.bottom = Math.max(0, Math.min(nb, window.innerHeight - fc.offsetHeight)) + 'px';
    e.preventDefault();
  }
  function end(){
    if(!dragging) return;
    dragging = false;
    try{ localStorage.setItem('floatingContactPosition', JSON.stringify({left:fc.style.left, bottom:fc.style.bottom})); }catch(e){}
  }
  handle.addEventListener('mousedown', start);
  document.addEventListener('mousemove', move);
  document.addEventListener('mouseup', end);
  handle.addEventListener('touchstart', start, {passive:false});
  document.addEventListener('touchmove', move, {passive:false});
  document.addEventListener('touchend', end);

  /* ===== FOOTER YEAR ===== */
  document.getElementById('year').textContent = new Date().getFullYear();
})();
</script>
</body>
</html>
