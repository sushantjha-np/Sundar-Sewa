  <style>
    /* ============ RESET & TOKENS ============ */
    *{margin:0;padding:0;box-sizing:border-box}
    :root{
      --ink:#1c1400; --dark:#171310; --darker:#14100c;
      --gold:#FECE0E; --orange:#FE7B03; --orange-deep:#e56700;
      --cream:#FFF9EE; --paper:#ffffff; --line:#f0e6d2;
      --muted:#6b6560; --muted-light:#cfc9c2;
      --font-head:'Sora',system-ui,sans-serif;
      --font-body:'Inter',system-ui,sans-serif;
      --ease:cubic-bezier(.22,1,.36,1);
      --shadow-lg:0 24px 60px rgba(20,12,4,.12);
    }
    html{scroll-behavior:smooth}
    body{font-family:var(--font-body);line-height:1.65;color:var(--ink);background:var(--paper);overflow-x:hidden;-webkit-font-smoothing:antialiased}
    body.intro-active{overflow:hidden}
    img{max-width:100%;display:block}
    a{text-decoration:none;color:inherit}
    ul{list-style:none}
    h1,h2,h3,h4{font-family:var(--font-head);line-height:1.25}
    .container{max-width:1200px;margin:0 auto;padding:0 24px}
    ::selection{background:var(--gold);color:var(--ink)}
    ::-webkit-scrollbar{width:10px}
    ::-webkit-scrollbar-track{background:var(--cream)}
    ::-webkit-scrollbar-thumb{background:linear-gradient(var(--orange),var(--gold));border-radius:8px}
    :focus-visible{outline:3px solid rgba(254,123,3,.55);outline-offset:2px;border-radius:4px}
    .skip-link{position:absolute;left:-9999px;top:0;background:var(--orange);color:#fff;padding:10px 18px;border-radius:0 0 10px 0;z-index:100000}
    .skip-link:focus{left:0}

    /* ============ BUTTONS ============ */
    .btn{display:inline-flex;align-items:center;gap:10px;padding:15px 32px;border-radius:50px;font-weight:700;font-size:.98rem;letter-spacing:.3px;border:none;cursor:pointer;transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s;will-change:transform;position:relative;overflow:hidden}
    .btn i{transition:transform .25s}
    .btn:hover i{transform:translateX(5px)}
    .btn-primary{background:linear-gradient(135deg,var(--gold),var(--orange));color:var(--ink);box-shadow:0 10px 26px rgba(254,123,3,.35)}
    .btn-primary:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(254,123,3,.45)}
    .btn-primary::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);transition:.6s}
    .btn-primary:hover::before{left:100%}
    .btn-ghost{border:1.5px solid rgba(255,255,255,.35);color:#fff;background:transparent}
    .btn-ghost:hover{border-color:var(--gold);color:var(--gold);transform:translateY(-3px)}
    .btn-white{background:#fff;color:#9a4b00;box-shadow:0 12px 28px rgba(0,0,0,.18)}
    .btn-white:hover{transform:translateY(-3px)}
    .btn-dark{background:var(--dark);color:#fff;box-shadow:0 12px 28px rgba(0,0,0,.2)}
    .btn-dark:hover{background:#000;transform:translateY(-3px)}

    /* ============ TOP BAR ============ */
    .top-header{background:var(--darker);color:#e8e2da;padding:9px 0;font-size:.88rem}
    .top-header .container{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
    .header-contact{display:flex;flex-wrap:wrap;gap:22px}
    .header-contact a{display:inline-flex;align-items:center;gap:8px;transition:color .2s}
    .header-contact a:hover{color:var(--gold)}
    .header-contact i{color:var(--gold);font-size:.85rem}
    .social-links{display:flex;gap:14px}
    .social-links a{width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:50%;border:1px solid rgba(255,255,255,.18);font-size:.8rem;transition:.25s var(--ease)}
    .social-links a:hover{background:linear-gradient(135deg,var(--gold),var(--orange));border-color:transparent;color:var(--ink);transform:translateY(-3px) rotate(15deg)}

    /* ============ HEADER ===== */
    header{position:sticky;top:0;z-index:1000;background:rgba(255,255,255,.92);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);transition:box-shadow .3s,background .3s,border-color .3s;border-bottom:1px solid transparent}
    header.scrolled{box-shadow:0 8px 30px rgba(20,12,4,.08);border-bottom-color:var(--line);background:rgba(255,255,255,.98)}
    header .container{display:flex;align-items:center;justify-content:space-between;padding-top:14px;padding-bottom:14px;gap:20px}
    .logo{display:flex;align-items:center;flex:none}
    .logo img{height:82px;width:auto;transition:transform .4s var(--ease)}
    .logo:hover img{transform:scale(1.03)}
    nav{display:flex;align-items:center;gap:26px}
    .nav-links{display:flex;gap:30px;font-weight:600;font-size:.95rem}
    .nav-links a{position:relative;padding:10px 0;color:var(--ink);transition:color .2s}
    .nav-links a::after{content:'';position:absolute;left:0;right:0;bottom:4px;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--gold),var(--orange));transform:scaleX(0);transform-origin:left;transition:transform .28s var(--ease)}
    .nav-links a:hover{color:var(--orange-deep)}
    .nav-links a:hover::after{transform:scaleX(1)}
    .nav-cta{padding:11px 24px;font-size:.88rem}
    .menu-toggle{display:none;font-size:1.6rem;cursor:pointer;color:var(--ink);background:none;border:none;padding:4px 8px;z-index:1102}
    .nav-backdrop{position:fixed;inset:0;background:rgba(10,8,5,.5);opacity:0;visibility:hidden;transition:.3s;z-index:1100;backdrop-filter:blur(4px)}
    .nav-backdrop.show{opacity:1;visibility:visible}

    /* ============ HERO ============ */
    .hero{position:relative;color:#fff;padding:100px 0 150px;overflow:hidden;isolation:isolate}
    /* Multi-layer professional background */
    .hero-bg{position:absolute;inset:0;z-index:-2;background:#1a1612;}
    .hero-bg::before{
      content:'';position:absolute;inset:0;
      background:
        linear-gradient(135deg, rgba(23,19,16,.85) 0%, rgba(30,22,14,.7) 50%, rgba(45,28,12,.85) 100%),
        url('https://images.unsplash.com/photo-1554224155-6726b3ff85aa?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat;
      filter:saturate(1.1);
    }
    .hero-bg::after{
      content:'';position:absolute;inset:0;
      background:
        linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
      background-size:48px 48px;
      animation:gridShift 20s linear infinite;
    }
    @keyframes gridShift{from{background-position:0 0,0 0}to{background-position:48px 48px,48px 48px}}
    .orb{position:absolute;border-radius:50%;filter:blur(110px);opacity:.55;pointer-events:none;animation:drift 18s ease-in-out infinite alternate;z-index:-1}
    .orb-1{width:520px;height:520px;background:var(--orange);top:-180px;right:-8%;animation-delay:0s}
    .orb-2{width:420px;height:420px;background:var(--gold);bottom:-150px;left:-10%;animation-delay:-7s}
    .orb-3{width:320px;height:320px;background:#ff5e2e;top:40%;left:40%;opacity:.25;animation-delay:-12s}
    @keyframes drift{from{transform:translate(0,0) scale(1)}to{transform:translate(-50px,40px) scale(1.15)}}
    .hero .container{position:relative;z-index:2;display:grid;grid-template-columns:1.08fr .92fr;gap:64px;align-items:center}
    .hero-badge{display:inline-flex;align-items:center;gap:10px;padding:9px 18px;border-radius:50px;border:1px solid rgba(254,206,14,.4);background:rgba(254,206,14,.1);color:var(--gold);font-size:.78rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;backdrop-filter:blur(8px);animation:badgePulse 3s ease-in-out infinite}
    @keyframes badgePulse{0%,100%{box-shadow:0 0 0 0 rgba(254,206,14,.4)}50%{box-shadow:0 0 0 12px rgba(254,206,14,0)}}
    .hero-badge .dot{width:8px;height:8px;border-radius:50%;background:var(--gold);animation:blink 1.6s infinite}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
    .hero h1{font-size:clamp(2.2rem,4.6vw,3.6rem);font-weight:800;margin:22px 0 18px;letter-spacing:-.5px;line-height:1.15}
    .hero h1 .grad{background:linear-gradient(90deg,var(--gold),var(--orange));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;background-size:200% 200%;animation:gradShift 6s ease infinite}
    @keyframes gradShift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
    .hero-slogan{font-size:1.18rem;color:var(--muted-light);max-width:540px;margin-bottom:34px;line-height:1.7}
    .hero-actions{display:flex;flex-wrap:wrap;gap:16px}
    .hero-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:48px;padding-top:30px;border-top:1px solid rgba(255,255,255,.15)}
    .stat{text-align:center;padding:8px 4px;transition:transform .3s var(--ease)}
    .stat:hover{transform:translateY(-4px)}
    .stat b{display:block;font-family:var(--font-head);font-size:2rem;font-weight:800;color:var(--gold);line-height:1}
    .stat span{font-size:.82rem;color:var(--muted-light);letter-spacing:.4px;margin-top:4px;display:block}

    /* Hero visual - finance dashboard mockup (replaces logo) */
    .hero-visual{position:relative;perspective:1200px}
    .dashboard-card{
      background:linear-gradient(155deg,#fff,#faf5e8);
      border-radius:26px;padding:32px 28px;
      transform:rotateY(-8deg) rotateX(6deg) translateY(10px);
      box-shadow:
        0 40px 80px rgba(0,0,0,.45),
        0 10px 20px rgba(0,0,0,.25);
      position:relative;transition:transform .6s var(--ease);
      animation:dashFloat 5s ease-in-out infinite;
    }
    @keyframes dashFloat{0%,100%{transform:rotateY(-8deg) rotateX(6deg) translateY(10px)}50%{transform:rotateY(-6deg) rotateX(4deg) translateY(0)}}
    .dashboard-card:hover{transform:rotateY(0) rotateX(0)}
    .dash-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;padding-bottom:14px;border-bottom:1px dashed #e8d7a8}
    .dash-head h3{font-size:1.05rem;font-weight:700}
    .dash-head .live{display:inline-flex;align-items:center;gap:6px;font-size:.72rem;color:#2ecc71;font-weight:600}
    .dash-head .live::before{content:'';width:7px;height:7px;border-radius:50%;background:#2ecc71;box-shadow:0 0 0 4px rgba(46,204,113,.25);animation:livePulse 2s infinite}
    @keyframes livePulse{0%{box-shadow:0 0 0 0 rgba(46,204,113,.5)}70%{box-shadow:0 0 0 10px rgba(46,204,113,0)}100%{box-shadow:0 0 0 0 rgba(46,204,113,0)}}
    .dash-metric{background:linear-gradient(135deg,#fff3d6,#ffe6c7);border-radius:16px;padding:18px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
    .dash-metric b{font-family:var(--font-head);font-size:1.55rem;font-weight:800;color:var(--orange-deep)}
    .dash-metric span{font-size:.78rem;color:var(--muted);margin-top:2px;display:block}
    .dash-metric .trend{color:#2ecc71;font-weight:700;font-size:.82rem}
    .dash-bars{display:flex;gap:8px;align-items:flex-end;height:80px;margin-top:18px;padding:12px 16px;background:#fff;border-radius:12px}
    .dash-bar{flex:1;background:linear-gradient(180deg,var(--orange),var(--gold));border-radius:4px 4px 0 0;animation:barGrow 2s var(--ease) forwards;transform-origin:bottom;transform:scaleY(0)}
    @keyframes barGrow{to{transform:scaleY(1)}}
    .chip{position:absolute;display:flex;align-items:center;gap:10px;background:rgba(23,19,16,.88);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.18);color:#fff;padding:12px 18px;border-radius:16px;font-size:.84rem;font-weight:600;box-shadow:0 14px 30px rgba(0,0,0,.35);animation:float 5s ease-in-out infinite;white-space:nowrap}
    .chip i{color:var(--gold);font-size:1.05rem}
    .chip-1{top:-24px;left:-26px}
    .chip-2{bottom:-22px;right:-14px;animation-duration:6s;animation-direction:reverse}
    .chip-3{top:30%;right:-70px;animation-duration:7s;background:linear-gradient(135deg,var(--orange),var(--gold));color:#221500;border-color:transparent}
    .chip-3 i{color:#221500}
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}

    /* hero entrance */
    .hero [data-anim]{opacity:0;transform:translateY(30px)}
    body.intro-done .hero [data-anim]{animation:fadeUp .9s var(--ease) forwards;animation-delay:var(--d,0s)}
    @keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}

    /* ============ FEATURES OVERLAP ============ */
    .features{margin-top:-78px;position:relative;z-index:6}
    .features-card{background:#fff;border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow-lg);display:grid;grid-template-columns:repeat(4,1fr);padding:34px 12px;transition:transform .4s var(--ease)}
    .features-card:hover{transform:translateY(-4px)}
    .feature{display:flex;gap:16px;align-items:flex-start;padding:4px 22px;border-right:1px solid var(--line);transition:background .3s}
    .feature:hover{background:linear-gradient(180deg,#fff8ea,#fff)}
    .feature:last-child{border-right:none}
    .feature i{flex:none;width:52px;height:52px;border-radius:15px;background:linear-gradient(135deg,var(--orange),var(--gold));color:#fff;font-size:1.25rem;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 18px rgba(254,123,3,.3);transition:transform .4s var(--ease)}
    .feature:hover i{transform:rotate(-12deg) scale(1.1)}
    .feature h3{font-size:1rem;margin-bottom:4px}
    .feature p{font-size:.86rem;color:var(--muted)}

    /* ============ SECTION HEADS ============ */
    section{padding:96px 0;position:relative}
    .section-head{text-align:center;margin-bottom:56px;position:relative;z-index:2}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.76rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--orange);padding:6px 16px;border-radius:50px;background:rgba(254,123,3,.08);border:1px solid rgba(254,123,3,.2)}
    .title{font-size:clamp(1.8rem,3.2vw,2.5rem);font-weight:800;color:var(--ink);margin:16px 0 14px;letter-spacing:-.4px}
    .sub{color:var(--muted);max-width:660px;margin:0 auto;font-size:1.02rem}

    /* ============ SERVICES (10 cards) ============ */
    .services{background:var(--cream);position:relative;overflow:hidden}
    .services::before{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(254,206,14,.12),transparent 70%);pointer-events:none}
    .services::after{content:'';position:absolute;bottom:-100px;left:-100px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(254,123,3,.12),transparent 70%);pointer-events:none}
    .services-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px;position:relative;z-index:2}
    .service-card{position:relative;background:#fff;padding:34px 26px;border-radius:22px;border:1px solid var(--line);transition:transform .35s var(--ease),box-shadow .35s var(--ease),border-color .35s;overflow:hidden;display:flex;flex-direction:column;cursor:default}
    .service-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--gold),var(--orange));transform:scaleX(0);transform-origin:left;transition:transform .4s var(--ease)}
    .service-card::after{content:'';position:absolute;top:18px;right:18px;font-family:'Font Awesome 6 Free';font-weight:900;font-size:.75rem;color:#ddd;transition:.3s;content:'\f061';transform:translate(-10px,10px);opacity:0}
    .service-card:hover{transform:translateY(-10px);box-shadow:0 26px 50px rgba(254,123,3,.15);border-color:#ffe1ad}
    .service-card:hover::before{transform:scaleX(1)}
    .service-card:hover::after{transform:translate(0,0);opacity:1;color:var(--orange)}
    .service-icon{width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,#fff3d6,#ffe6c7);color:var(--orange-deep);font-size:1.5rem;display:flex;align-items:center;justify-content:center;margin-bottom:20px;transition:transform .4s var(--ease);position:relative}
    .service-icon::before{content:'';position:absolute;inset:-4px;border-radius:22px;background:linear-gradient(135deg,var(--gold),var(--orange));opacity:0;z-index:-1;transition:opacity .3s}
    .service-card:hover .service-icon{transform:scale(1.08) rotate(-6deg)}
    .service-card:hover .service-icon::before{opacity:.2}
    .service-card h3{font-size:1.12rem;margin-bottom:8px}
    .service-card .np{font-size:.8rem;color:var(--orange);font-weight:600;margin-bottom:6px;display:block;letter-spacing:.3px}
    .service-card p{font-size:.88rem;color:var(--muted);line-height:1.6}

    /* ============ VIDEO SECTION ============ */
    .video-section{background:var(--paper);padding:96px 0;position:relative;overflow:hidden}
    .video-wrap{max-width:920px;margin:0 auto;border-radius:28px;overflow:hidden;position:relative;box-shadow:0 30px 70px rgba(20,12,4,.18);border:8px solid #fff;background:#000;aspect-ratio:16/9}
    .video-wrap iframe{width:100%;height:100%;border:0;display:block}
    .video-wrap::after{content:'';position:absolute;inset:-2px;border-radius:28px;pointer-events:none;background:linear-gradient(135deg,var(--gold),var(--orange));z-index:-1;filter:blur(30px);opacity:.4}

    /* ============ ABOUT ============ */
    .about{background:linear-gradient(180deg,#fff,#fdf9ed)}
    .about-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center}
    /* About visual - finance illustration card (no logo) */
    .about-visual{position:relative;perspective:1000px}
    .about-card{
      background:linear-gradient(160deg,#fff8ea,#fff);
      border:1px solid var(--line);border-radius:28px;
      padding:48px 40px;box-shadow:var(--shadow-lg);
      transform:rotateY(6deg);transition:transform .6s var(--ease);
      position:relative;overflow:hidden;
    }
    .about-card:hover{transform:rotateY(0)}
    .about-card::before{content:'';position:absolute;top:0;right:0;width:200px;height:200px;background:radial-gradient(circle,rgba(254,206,14,.18),transparent 70%);pointer-events:none}
    .about-icon-row{display:flex;gap:14px;margin-bottom:24px;flex-wrap:wrap}
    .about-icon-row .aic{
      width:66px;height:66px;border-radius:18px;
      background:linear-gradient(135deg,#fff3d6,#ffe6c7);
      color:var(--orange-deep);font-size:1.5rem;
      display:flex;align-items:center;justify-content:center;
      box-shadow:0 8px 20px rgba(254,123,3,.18);
      transition:transform .4s var(--ease);
    }
    .about-icon-row .aic:nth-child(odd){animation:iconBounce 4s ease-in-out infinite}
    .about-icon-row .aic:nth-child(even){animation:iconBounce 4s ease-in-out infinite;animation-delay:-2s}
    @keyframes iconBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
    .about-icon-row .aic:hover{transform:translateY(-8px) rotate(-6deg)!important}
    .about-stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:8px}
    .about-stat-row .as{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 8px;text-align:center;transition:.3s var(--ease)}
    .about-stat-row .as:hover{transform:translateY(-4px);border-color:var(--gold)}
    .about-stat-row .as b{display:block;font-family:var(--font-head);font-size:1.5rem;font-weight:800;color:var(--orange-deep);line-height:1}
    .about-stat-row .as span{font-size:.72rem;color:var(--muted);letter-spacing:.4px;text-transform:uppercase;margin-top:4px;display:block}
    .about-text .eyebrow{margin-bottom:4px}
    .about-text .title{text-align:left;margin-bottom:18px}
    .about-text p{color:var(--muted);margin-bottom:16px;font-size:1rem}
    .checklist{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px;margin:24px 0 8px}
    .checklist li{display:flex;align-items:center;gap:10px;font-weight:600;font-size:.92rem}
    .checklist i{color:var(--orange);font-size:1.05rem;flex:none}
    .about blockquote{margin-top:26px;padding:22px 26px;background:#fff8ea;border-left:5px solid var(--orange);border-radius:0 16px 16px 0;font-style:italic;font-size:1.08rem;color:var(--ink);position:relative}
    .about blockquote::before{content:'\201C';position:absolute;top:-18px;left:14px;font-size:4rem;color:var(--gold);font-family:Georgia,serif;line-height:1}

    /* ============ CTA ============ */
    .cta{padding:0 0 96px}
    .cta-inner{position:relative;overflow:hidden;background:linear-gradient(135deg,#ff9a3e,var(--orange) 55%,var(--orange-deep));border-radius:32px;padding:64px 56px;display:flex;align-items:center;justify-content:space-between;gap:36px;box-shadow:0 30px 60px rgba(254,123,3,.3)}
    .cta-inner::before,.cta-inner::after{content:'';position:absolute;border-radius:50%;background:rgba(255,255,255,.12)}
    .cta-inner::before{width:320px;height:320px;top:-140px;right:-80px;animation:ctaFloat 8s ease-in-out infinite}
    .cta-inner::after{width:220px;height:220px;bottom:-110px;left:-60px;animation:ctaFloat 10s ease-in-out infinite reverse}
    @keyframes ctaFloat{0%,100%{transform:translate(0,0)}50%{transform:translate(20px,-20px)}}
    .cta-inner h2{color:#fff;font-size:clamp(1.5rem,2.6vw,2.1rem);margin-bottom:10px}
    .cta-inner p{color:rgba(255,255,255,.92);max-width:520px}
    .cta-actions{position:relative;z-index:2;display:flex;flex-direction:column;gap:14px;flex:none}

    /* ============ CONTACT ============ */
    .contact{background:var(--cream)}
    .contact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
    .contact-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:34px 26px;text-align:center;transition:transform .3s var(--ease),box-shadow .3s var(--ease);position:relative;overflow:hidden}
    .contact-card::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:linear-gradient(135deg,transparent,rgba(254,206,14,.06),transparent);transform:rotate(45deg) translateX(-100%);transition:.8s}
    .contact-card:hover::before{transform:rotate(45deg) translateX(100%)}
    .contact-card:hover{transform:translateY(-8px);box-shadow:0 20px 44px rgba(20,12,4,.12)}
    .contact-card i{width:58px;height:58px;border-radius:16px;background:linear-gradient(135deg,#fff3d6,#ffe6c7);color:var(--orange-deep);font-size:1.35rem;display:inline-flex;align-items:center;justify-content:center;margin-bottom:18px;transition:transform .4s var(--ease)}
    .contact-card:hover i{transform:scale(1.1) rotate(-6deg)}
    .contact-card h3{font-size:1.05rem;margin-bottom:8px}
    .contact-card p{font-size:.9rem;color:var(--muted);line-height:1.55}
    .contact-card a{color:var(--orange-deep);font-weight:600}

    /* ============ MAP ============ */
    .map-section{padding:96px 0}
    .map-actions{display:flex;justify-content:center;gap:16px;margin-bottom:34px;flex-wrap:wrap;position:relative;z-index:3}
    .map-wrapper{border-radius:28px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow-lg);position:relative}
    .map-wrapper iframe{display:block;width:100%;height:440px;border:0}
    .map-wrapper::before{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 85%,rgba(0,0,0,.1));z-index:1}

    /* ============ FOOTER ============ */
    footer{background:var(--darker);color:#cfc9c2;padding-top:72px}
    .footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.3fr;gap:44px;padding-bottom:52px}
    .f-logo{display:inline-block;background:#fff;border-radius:14px;padding:10px 16px;margin-bottom:20px}
    .f-logo img{height:46px;width:auto}
    .footer-about p{font-size:.92rem;opacity:.85;margin-bottom:20px}
    .f-social{display:flex;gap:12px}
    .f-social a{width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:.25s var(--ease)}
    .f-social a:hover{background:linear-gradient(135deg,var(--gold),var(--orange));border-color:transparent;color:var(--ink);transform:translateY(-4px) rotate(15deg)}
    footer h4{color:#fff;font-size:1.02rem;margin-bottom:20px;position:relative;padding-bottom:12px}
    footer h4::after{content:'';position:absolute;left:0;bottom:0;width:34px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--gold),var(--orange))}
    .footer-links li{margin-bottom:11px}
    .footer-links a{opacity:.8;font-size:.92rem;transition:.25s var(--ease)}
    .footer-links a:hover{opacity:1;color:var(--gold);padding-left:6px}
    .footer-contact li{display:flex;gap:12px;margin-bottom:14px;font-size:.92rem;align-items:flex-start}
    .footer-contact i{color:var(--orange);margin-top:4px;width:18px;flex:none}
    .footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding:22px 0}
    .footer-bottom .container{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:.9rem}
    .author-badge{display:inline-flex;align-items:center;gap:10px;padding:9px 18px;border:1px solid rgba(255,255,255,.16);border-radius:999px;background:rgba(255,255,255,.04);transition:.3s var(--ease);font-size:.88rem}
    .author-badge img{width:26px;height:26px;border-radius:50%;background:#fff;padding:3px;object-fit:contain}
    .author-badge strong{background:linear-gradient(90deg,var(--gold),var(--orange));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;letter-spacing:1px}
    .author-badge:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 10px 24px rgba(254,206,14,.15)}

    /* ============ FLOATING CONTACT ============ */
    .floating-contact-container{position:fixed;left:20px;bottom:20px;z-index:999;display:flex;flex-direction:column;align-items:flex-end}
    .contact-buttons{display:flex;flex-direction:column;gap:12px}
    .contact-button{display:flex;align-items:center;justify-content:center;width:58px;height:58px;border-radius:50%;box-shadow:0 10px 24px rgba(0,0,0,.2);transition:transform .25s var(--ease)}
    .contact-button:hover{transform:translateY(-4px) scale(1.08)}
    .whatsapp{background:#25D366}
    .call{background:linear-gradient(135deg,var(--orange),var(--gold))}
    .contact-button svg{width:28px;height:28px;fill:#fff}
    .drag-handle{width:40px;height:40px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-top:10px;box-shadow:0 6px 16px rgba(0,0,0,.15);cursor:grab;color:var(--ink)}

    /* ============ BACK TO TOP ============ */
    #toTop{position:fixed;right:22px;bottom:22px;width:48px;height:48px;border-radius:14px;border:none;background:linear-gradient(135deg,var(--gold),var(--orange));color:#221500;font-size:1.05rem;cursor:pointer;opacity:0;visibility:hidden;transform:translateY(14px);transition:.35s var(--ease);box-shadow:0 12px 26px rgba(254,123,3,.35);z-index:998}
    #toTop.show{opacity:1;visibility:visible;transform:translateY(0)}
    #toTop:hover{transform:translateY(-4px)}

    /* ============ INTRO OVERLAY ============ */
    #proIntro{position:fixed;inset:0;background:radial-gradient(700px 340px at 50% 0%,#fff6dd,#ffffff 70%);display:flex;align-items:center;justify-content:center;z-index:99999;transition:opacity .45s ease,visibility .45s ease}
    #proIntro.hidden{opacity:0;visibility:hidden;pointer-events:none}
    .intro-content{text-align:center;padding:40px;animation:introUp .7s var(--ease)}
    @keyframes introUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
    .intro-logo{width:240px;height:auto;margin:0 auto 22px;filter:drop-shadow(0 14px 34px rgba(254,206,14,.5));animation:introPulse 1.4s ease-in-out infinite alternate}
    @keyframes introPulse{from{transform:scale(1)}to{transform:scale(1.045)}}
    .intro-company{font-family:var(--font-head);font-size:2.3rem;font-weight:800;letter-spacing:3px;background:linear-gradient(90deg,var(--gold),var(--orange));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;margin-bottom:12px;background-size:200% 200%;animation:introGrad 4s ease infinite}
    @keyframes introGrad{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
    .intro-slogan{font-size:1.05rem;color:#5a544d;max-width:480px;margin:0 auto 30px}
    .intro-loader{width:220px;height:5px;background:rgba(0,0,0,.08);border-radius:4px;overflow:hidden;margin:0 auto}
    .loader-bar{height:100%;width:0%;background:linear-gradient(90deg,var(--gold),var(--orange));border-radius:4px;animation:load 2s ease-in-out forwards}
    @keyframes load{to{width:100%}}
    .intro-credit{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);display:inline-flex;align-items:center;gap:9px;padding:8px 18px;border:1px solid #eadfc6;border-radius:999px;background:#fff;box-shadow:0 8px 22px rgba(20,12,4,.08);font-size:.82rem;color:#5a544d;white-space:nowrap;transition:.25s}
    .intro-credit img{width:22px;height:22px;border-radius:50%;object-fit:contain}
    .intro-credit strong{color:var(--ink);letter-spacing:1px}
    .intro-credit:hover{border-color:var(--orange);transform:translateX(-50%) translateY(-2px)}

    /* ============ SCROLL REVEAL ============ */
    .reveal{opacity:0;transform:translateY(32px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
    .reveal.visible{opacity:1;transform:translateY(0)}
    .reveal-left{opacity:0;transform:translateX(-40px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
    .reveal-left.visible{opacity:1;transform:translateX(0)}
    .reveal-right{opacity:0;transform:translateX(40px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
    .reveal-right.visible{opacity:1;transform:translateX(0)}
    .reveal-scale{opacity:0;transform:scale(.92);transition:opacity .8s var(--ease),transform .8s var(--ease)}
    .reveal-scale.visible{opacity:1;transform:scale(1)}
    .services-grid .service-card:nth-child(1){transition-delay:0s}
    .services-grid .service-card:nth-child(2){transition-delay:.06s}
    .services-grid .service-card:nth-child(3){transition-delay:.12s}
    .services-grid .service-card:nth-child(4){transition-delay:.18s}
    .services-grid .service-card:nth-child(5){transition-delay:.24s}
    .services-grid .service-card:nth-child(6){transition-delay:.3s}
    .services-grid .service-card:nth-child(7){transition-delay:.36s}
    .services-grid .service-card:nth-child(8){transition-delay:.42s}
    .services-grid .service-card:nth-child(9){transition-delay:.48s}
    .services-grid .service-card:nth-child(10){transition-delay:.54s}
    .contact-grid .contact-card:nth-child(2){transition-delay:.08s}
    .contact-grid .contact-card:nth-child(3){transition-delay:.16s}
    .contact-grid .contact-card:nth-child(4){transition-delay:.24s}

    /* ============ RESPONSIVE ============ */
    @media (max-width:1080px){
      .hero .container{grid-template-columns:1fr;gap:80px;text-align:center}
      .hero-slogan{margin-left:auto;margin-right:auto}
      .hero-actions{justify-content:center}
      .hero-visual{max-width:560px;margin:0 auto}
      .features-card{grid-template-columns:repeat(2,1fr);gap:26px 0}
      .feature:nth-child(2){border-right:none}
      .about-grid{grid-template-columns:1fr;gap:70px}
      .about-text .title{text-align:center}
      .about-text .eyebrow{justify-content:center}
      .contact-grid{grid-template-columns:repeat(2,1fr)}
      .footer-grid{grid-template-columns:repeat(2,1fr)}
      .chip-3{right:-30px}
    }
    @media (max-width:992px){
      .nav-cta{display:none}
      .menu-toggle{display:block}
      .nav-links{position:fixed;top:0;right:0;width:min(78%,320px);height:100vh;height:100dvh;background:#fff;flex-direction:column;padding:96px 34px 34px;gap:6px;box-shadow:-14px 0 40px rgba(0,0,0,.16);transform:translateX(100%);transition:transform .35s var(--ease);z-index:1101;overflow-y:auto}
      .nav-links.open{transform:translateX(0)}
      .nav-links a{font-size:1.1rem;padding:12px 0;border-bottom:1px solid #f4efe4}
      .nav-links a::after{display:none}
    }
    @media (max-width:640px){
      section{padding:72px 0}
      .top-header .container{flex-direction:column;align-items:center}
      .hero{padding:70px 0 130px}
      .hero-stats{grid-template-columns:repeat(2,1fr)}
      .chip-1{left:-6px;top:-18px}
      .chip-2{right:-6px;bottom:-18px}
      .chip-3{display:none}
      .features-card{grid-template-columns:1fr}
      .feature{border-right:none;border-bottom:1px solid var(--line);padding-bottom:22px}
      .feature:last-child{border-bottom:none}
      .checklist{grid-template-columns:1fr}
      .cta-inner{flex-direction:column;text-align:center;padding:48px 28px}
      .contact-grid{grid-template-columns:1fr}
      .footer-grid{grid-template-columns:1fr}
      .footer-bottom .container{flex-direction:column;text-align:center}
      .map-wrapper iframe{height:320px}
      .logo img{height:62px}
      .about-card{padding:36px 28px;transform:none}
      .about-icon-row .aic{width:58px;height:58px;font-size:1.3rem}
    }

    /* ============ REDUCED MOTION ============ */
    @media (prefers-reduced-motion:reduce){
      *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
      html{scroll-behavior:auto}
      .reveal,.reveal-left,.reveal-right,.reveal-scale,.hero [data-anim]{opacity:1!important;transform:none!important}
    }
  </style>
  <noscript>
    <style>
      #proIntro{display:none}
      .reveal,.reveal-left,.reveal-right,.reveal-scale,.hero [data-anim]{opacity:1!important;transform:none!important}
    </style>
  </noscript>
</head>
